{
  "version": "2.0.1-alpha.0",
  "packages": [
    "packages/*"
  ],
  "npmClient": "npm",
  "command": {
    "bootstrap": {
      "hoist": true
    },
    "lint": {
      "hoist": true
    },
    "fmt": {
      "hoist": true
    },
    "test": {
      "hoist": true
    },
    "version": {
      "allowBranch": [
        "stable",
        "beta",
        "main"
      ],
      "conventionalCommits": true,
      "createRelease": "github",
      "message": "release: %s",
      "tagVersionPrefix": ""
    }
  }
}
