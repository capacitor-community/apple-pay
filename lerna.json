{
  "version": "2.0.2",
  "packages": [
    "packages/*"
  ],
  "npmClient": "pnpm",
  "command": {
    "version": {
      "allowBranch": [
        "stable",
        "beta",
        "main"
      ],
      "conventionalCommits": true,
      "createRelease": "github",
      "message": "release: %s",
      "tagVersionPrefix": ""
    }
  }
}