{
  "name": "@ionic-enterprise/apple-pay",
  "version": "1.0.2",
  "description": "Capacitor Plugin used to enable Apple Pay in an Application",
  "author": "Ionic Team <hi@ionic.io> (https://ionicframework.com)",
  "license": "SEE LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/enterprise-apple-pay"
  },
  "main": "dist/plugin.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "lint": "npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- autocorrect --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\"",
    "swiftlint": "node-swiftlint",
    "build": "npm run clean && tsc && rollup -c rollup.config.js",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "remove-void-implements": "node ../../scripts/remove-void-implements.js",
    "docs": "typedoc --plugin typedoc-plugin-markdown --theme ./node_modules/@ionic/markdown-docs-theme/dist src/index.ts && rm -rf ../../website/docs/{enums,interfaces,classes} && mv api/{enums,interfaces,classes} ../../website/docs && mv api/modules.md ../../website/docs/modules.md && rm -rf api"
  },
  "devDependencies": {
    "@capacitor/android": ">=3.1.1",
    "@capacitor/core": ">=3.1.1",
    "@capacitor/ios": ">=3.1.1",
    "@ionic/eslint-config": "^0.3.0",
    "@ionic/markdown-docs-theme": "^3.0.1",
    "@ionic/prettier-config": "^1.0.1",
    "@ionic/swiftlint-config": "^1.1.2",
    "@rollup/plugin-node-resolve": "^8.1.0",
    "eslint": "^7.32.0",
    "prettier": "^2.3.2",
    "prettier-plugin-java": "^0.8.0",
    "rimraf": "^3.0.0",
    "rollup": "^2.21.0",
    "swiftlint": "^1.0.1",
    "typedoc": "^0.20.30",
    "typedoc-plugin-markdown": "3.6.0",
    "typescript": "~3.9.10"
  },
  "peerDependencies": {
    "@capacitor/core": ">=3.1.1"
  },
  "files": [
    "dist/",
    "ios/",
    "android/",
    "IonicEnterpriseApplePay.podspec"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "bugs": {
    "url": "https://github.com/ionic-team/enterprise-apple-pay/issues"
  }
}
